---
apiVersion: v1alpha1
kind: ExtensionServiceConfig
name: tailscale
environment:
  - TS_AUTHKEY=op://infrastructure/headscale/TS_AUTH_KEY
  - TS_STATE_DIR=/var/lib/tailscale/headscale
  - TS_HOSTNAME=frostlink
  - TS_ROUTES=10.0.0.203/32
  - TS_EXTRA_ARGS=--login-server=https://headscale.frostlink.dev --accept-routes --snat-subnet-routes=false
