{{- $cluster := printf "../../../apps/%s/%s/app/helmrelease.yaml" .Release.Namespace .Release.Name -}}
{{- $base := printf "../../../../../base/%s/%s/app/helmrelease.yaml" .Release.Namespace .Release.Name -}}
{{- $extras := printf "../../../apps/%s/%s/app/values.yaml" .Release.Namespace .Release.Name -}}
{{- $values := (fromYaml (readFile (ternary $cluster $base (isFile $cluster)))).spec.values | default dict -}}
{{- if isFile $extras }}{{- $values = mergeOverwrite (fromYaml (readFile $extras)) $values -}}{{- end -}}
{{ $values | toYaml }}
