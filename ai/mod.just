# Agent tooling — lint and evaluate this repo's own agent config

[private]
default:
    @just --list ai

# Audit the agent config — symlinks, frontmatter, @imports, the reference index
[group('ai')]
lint-agents:
    @python3 "{{ justfile_directory() }}/scripts/check-agent-config.py"

# Behavioural tests for the instruction set — costs tokens, so on demand, never in a hook
[group('ai')]
eval *ARGS:
    @python3 "{{ justfile_directory() }}/scripts/eval-instructions.py" {{ ARGS }}

# Only `just ai eval` needs .env — Claude Code's MCP servers authenticate through .mcp.json's
# headersHelper, not through this file.
#
# Regenerate .env with the LiteLLM key and Forgejo PAT from 1Password (gitignored)
[group('ai')]
env:
    #!/usr/bin/env bash
    set -euo pipefail
    # In a just module, justfile_directory() is the ROOT justfile's dir (the repo root),
    # not ai/. Do not append `..` here; that writes the secret to $HOME.
    cd "{{ justfile_directory() }}"
    umask 077
    {
      echo "# Generated by \`just ai env\` — gitignored, do not commit."
      echo "LITELLM_API_KEY=$(op read 'op://artemis/litellm/OPENCODE_CLI_KEY')"
      echo "FORGEJO_TOKEN=$(op read 'op://artemis/forgejo/FORGEJO_PAT')"
    } > .env
    echo "wrote .env ($(wc -l < .env) lines, mode $(stat -c %a .env))"
