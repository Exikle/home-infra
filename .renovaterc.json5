{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "local>exikle/renovate-config",
    "local>exikle/renovate-config:cluster",
    "github>home-operations/renovate-presets//apps/phanpy.json5#8.1.0",
  ],
  platformCommit: "enabled",
  schedule: ["at any time"],
  automergeSchedule: ["at any time"],
  ignorePaths: ["**/*.secret.*", "**/resources/**"],
  packageRules: [
    {
      description: "Auto-merge trusted container digests",
      matchDatasources: ["docker"],
      automerge: true,
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      ignoreTests: false,
    },
    {
      description: "Forgejo Actions merge as branches — platformCommit signs them, so no PR is needed",
      matchManagers: ["github-actions"],
      automergeType: "branch",
    },
    {
      description: "Hold Talos for 7 days before opening the PR",
      matchPackageNames: ["siderolabs/talos"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Never auto-merge tuppr-driven Talos or Kubernetes upgrades",
      matchFileNames: ["kubernetes/apps/system-upgrade/tuppr/upgrades/**"],
      automerge: false,
      minimumReleaseAge: "7 days",
      prBodyNotes: [
        "> ⛔ **Do not automerge.** tuppr rolls this Talos or Kubernetes upgrade onto the only node.",
      ],
    },
    {
      description: "Hold the Kubernetes group for 7 days before opening the PR",
      matchDatasources: ["docker"],
      matchPackageNames: ["/siderolabs\\/kubelet/", "/kube-proxy/"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Never auto-merge Cilium — the CNI of a single node; one dependency, so no group",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cilium\\/charts\\/cilium/"],
      automerge: false,
      prBodyNotes: ["> ⛔ **Do not automerge.** Cilium is the CNI of the only node."],
    },
    {
      description: "CNPG Group — batches the updates that recreate the single Postgres instance",
      groupName: "cnpg",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cloudnative-pg/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      schedule: ["* 4-6 * * 6"],
    },
    {
      description: "Priority labels by update type",
      matchUpdateTypes: ["major"],
      addLabels: ["priority/high"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["priority/medium"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["priority/low"],
    },
    {
      description: "Label container updates",
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      description: "Label Helm updates",
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      description: "Label GitHub Release updates",
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Label Forgejo Actions updates",
      matchManagers: ["github-actions"],
      addLabels: ["renovate/forgejo-action"],
    },
  ],
}
