{
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-manifest.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl logs:*)",
      "Bash(flux get:*)",
      "Bash(flux describe:*)",
      "Bash(flux reconcile:*)",
      "Bash(flux suspend:*)",
      "Bash(flux resume:*)",
      "Bash(talosctl get:*)",
      "Bash(talosctl health:*)",
      "Bash(talosctl version:*)",
      "Bash(talosctl dmesg:*)",
      "Bash(mise exec:*)",
      "Bash(just kube:*)",
      "Bash(just talos:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.talos.dev)",
      "WebFetch(domain:docs.siderolabs.com)"
    ]
  }
}
