{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "The vchord Database version follows ghcr.io/home-operations/vchord, not the cnpg preset's vchord-scratch",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"],
      enabled: false,
    },
  ],
}
